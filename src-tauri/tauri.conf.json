{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caster",
  "version": "0.1.0",
  "identifier": "com.steverothier.caster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caster",
        "width": 980,
        "height": 700,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Caster Overlay",
        "width": 340,
        "height": 56,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "transparent": true
      },
      {
        "label": "picker",
        "title": "Choisir un point",
        "width": 800,
        "height": 600,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "fullscreen": false
      },
      {
        "label": "zones",
        "title": "Zones de sécurité",
        "width": 800,
        "height": 600,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "SteveRothier",
    "copyright": "Copyright © 2026 SteveRothier",
    "category": "Productivity",
    "shortDescription": "Automatisation Windows — macros, clicker et scripts locaux.",
    "longDescription": "Caster est une application d’automatisation Windows 100 % locale (macros, clicker, scripts). Aucune télémétrie. Injection clavier/souris et hotkeys globales nécessitent un package full-trust (Desktop Bridge).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
