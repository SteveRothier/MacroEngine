{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caster",
  "version": "0.1.0",
  "identifier": "com.steverothier.caster",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Caster",
        "width": 980,
        "height": 700,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "Caster Overlay",
        "width": 240,
        "height": 72,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "transparent": true
      },
      {
        "label": "picker",
        "title": "Choisir un point",
        "width": 800,
        "height": 600,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "fullscreen": false
      },
      {
        "label": "zones",
        "title": "Zones de sécurité",
        "width": 800,
        "height": 600,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000",
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
