<Window x:Class="MacroEngine.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="MacroEngine" 
        Width="1280" Height="760"
        MinWidth="900" MinHeight="560"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- Style spécifique pour les items du ComboBox Mode de déclenchement -->
        <Style x:Key="TriggerModeComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <Grid ToolTip="{Binding Tooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                           FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Border Grid.Column="1" Margin="4,0,0,0" Padding="4,2,4,2"
                                        CornerRadius="0"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTip="Recommandé selon les actions de la macro">
                                    <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#254FB58C"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                    </Border.Style>
                                    <TextBlock Text="&#xE238;" FontFamily="{StaticResource FontLucide}" FontSize="12"
                                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BackgroundTertiaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
          Titres de sections barre d’outils (discrets : couleur atténuée, semi-gras, petite taille).
          Fenêtre transparente : ClearType explicite pour un rendu net.
        -->
        <Style x:Key="ToolbarSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontToolbarSection}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Opacity" Value="0.88"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
            <Setter Property="TextOptions.TextHintingMode" Value="Fixed"/>
            <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
        </Style>
        <!-- Raccourcis à côté des icônes EXECUTION : même police / couleur que les titres de section, largeur fixe -->
        <Style x:Key="ToolbarShortcutHintStyle" TargetType="TextBlock" BasedOn="{StaticResource ToolbarSectionLabelStyle}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- Libellés champs panneau Propriétés : même rendu que TOUCHE / CLIC (barre d’outils) -->
        <Style x:Key="PropsPanelFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <!-- Rail macros : hauteur max par ligne (BasedOn pour ne pas toucher la liste profils) -->
        <Style x:Key="MacroListMainWindowItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource MacroListItemStyle}">
            <Setter Property="MaxHeight" Value="70"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <!-- Style barre d'action (boutons type carte) -->
        <Style x:Key="ActionCard" TargetType="Button" BasedOn="{StaticResource ButtonGhost}">
            <Setter Property="Padding" Value="12,6,12,8"/>
            <Setter Property="MinWidth" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#161916"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Root — fenêtre avec bordure custom (style référence) -->
    <Border x:Name="RootBorder" Background="#080A08" BorderBrush="{StaticResource BorderLightBrush}"
            ClipToBounds="True">
        <Border.Style>
            <Style TargetType="Border">
                <!-- Fenêtre (Normal) : bordure + coins arrondis. Maximisé : pas de bordure extérieure ni rayon. -->
                <Setter Property="Margin" Value="0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════ TITLEBAR ══════════════════════════════════════ -->
            <Border x:Name="TitleBarBorder" Grid.Row="0"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    Background="#0D0F0D"
                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Logo (gauche) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="14,0,16,0" HorizontalAlignment="Left">
                        <TextBlock Text="MACROENGINE"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="20" FontWeight="Black"
                                   Foreground="#E8A020" VerticalAlignment="Bottom">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#E8A020" BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </StackPanel>

                    <!-- Icône (sans cadre) + nom de la macro (centre de la barre) -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <Grid Width="18" Height="18"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding SelectedItem.IconType, ElementName=MacrosListBox, Converter={StaticResource IconVisibilityConverter}}">
                            <TextBlock FontFamily="{StaticResource FontLucide}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Text="{Binding SelectedItem.LucideIconCode, ElementName=MacrosListBox, Converter={StaticResource LucideIconCharConverter}, FallbackValue='', TargetNullValue=''}"
                                       Foreground="{Binding SelectedItem.IconColor, ElementName=MacrosListBox, Converter={StaticResource HexToBrushConverter}}"
                                       Visibility="{Binding SelectedItem.IconType, ElementName=MacrosListBox, Converter={StaticResource IconTypeMatchConverter}, ConverterParameter=Lucide}"/>
                            <Image Width="15" Height="15"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   SnapsToDevicePixels="True"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{Binding SelectedItem.ProcessIconPath, ElementName=MacrosListBox, Converter={StaticResource ProcessIconConverter}}"
                                   Visibility="{Binding SelectedItem.IconType, ElementName=MacrosListBox, Converter={StaticResource IconTypeMatchConverter}, ConverterParameter=Process}"/>
                        </Grid>
                        <TextBlock x:Name="TitleBarActiveMacroText"
                                   Text="{Binding SelectedItem.Name, ElementName=MacrosListBox, FallbackValue='', TargetNullValue=''}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#E8A020"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="400"
                                   ToolTip="{Binding SelectedItem.Name, ElementName=MacrosListBox, FallbackValue='', TargetNullValue=''}"/>
                    </StackPanel>

                    <!-- Droite : séparateurs, journaux, paramètres, fenêtre -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,14,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Rectangle Width="1" Height="18" Fill="{StaticResource BorderLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ButtonIcon}" Width="28" Height="28" Click="ShowLogs_Click" ToolTip="Journaux" Margin="0,0,8,0">
                            <TextBlock Text="&#xE085;" FontFamily="{StaticResource FontLucide}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Style="{StaticResource ButtonIcon}" Width="28" Height="28" Click="Settings_Click" ToolTip="Paramètres" Margin="0,0,8,0">
                            <TextBlock Text="&#xE30B;" FontFamily="{StaticResource FontLucide}" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Button>
                        <Rectangle Width="1" Height="18" Fill="{StaticResource BorderLightBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button x:Name="MinimizeButton" Style="{StaticResource WindowCaptionButtonStyle}" Width="40" Height="28"
                                Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontLucide}" FontSize="12"
                                Content="&#xE11C;" ToolTip="Réduire" Click="MinimizeButton_Click"/>
                        <Button x:Name="MaximizeButton" Style="{StaticResource WindowCaptionButtonStyle}" Width="40" Height="28"
                                Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontLucide}" FontSize="12"
                                Content="&#xE167;" ToolTip="Agrandir" Click="MaximizeButton_Click"/>
                        <Button x:Name="CloseButton" Style="{StaticResource WindowCaptionCloseButtonStyle}" Width="40" Height="28"
                                Foreground="{StaticResource TextPrimaryBrush}" FontFamily="{StaticResource FontLucide}" FontSize="12"
                                Content="&#xE1B2;" ToolTip="Fermer" Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════ SHELL (Rail | Workspace | Props) ══════════════════════════════════════ -->
            <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <!-- Sidebar gauche (largeur rail v2) -->
                <ColumnDefinition Width="200"/>
                <!-- Sans espace entre la colonne gauche et l'éditeur -->
                <ColumnDefinition Width="0"/>
                <!-- Zone centrale (éditeur) -->
                <ColumnDefinition Width="*"/>
                <!-- Colonnes réservées au mode panneau docké (désactivé: props en overlay) -->
                <ColumnDefinition Width="0"/>
                <ColumnDefinition Width="0"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════ RAIL (gauche) ═══════════════════════════ -->
            <Border x:Name="LeftColumnBorder" Grid.Column="0"
                    Background="#0D0F0D"
                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0"
                    Padding="12,14,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- ＋ Nouvelle Macro (ambre, CTA v2, style clip-path approché) -->
                    <Button Grid.Row="0"
                            Style="{StaticResource ButtonSidebarPrimary}"
                            Click="NewMacro_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,6"
                            Padding="9,9"
                            ToolTip="Nouvelle macro">
                        <Grid>
                            <!-- Corps du bouton -->
                            <Border Background="{x:Null}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="＋"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="15"
                                               FontWeight="ExtraBold"
                                               Margin="0,0,6,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="NOUVELLE MACRO"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="13"
                                               FontWeight="ExtraBold"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="Aliased"/>
                        </StackPanel>
                            </Border>
                        </Grid>
                    </Button>

                    <!-- Import / Export (rail-btn style) -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource ButtonSidebarSecondary}"
                                Click="ImportMacro_Click" HorizontalAlignment="Stretch" Padding="6,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE0D7;" FontFamily="{StaticResource FontLucide}" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="10"/>
                                <TextBlock Text="Import" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource ButtonSidebarSecondary}"
                                Click="ExportMacro_Click" HorizontalAlignment="Stretch" Padding="6,5">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE19E;" FontFamily="{StaticResource FontLucide}" Margin="0,0,4,0" VerticalAlignment="Center" FontSize="10"/>
                                <TextBlock Text="Export" VerticalAlignment="Center" FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="2" Height="1" Background="{StaticResource BorderMediumBrush}" Margin="0,0,0,8"/>

                    <!-- Section label MACROS — X -->
                    <TextBlock Grid.Row="3"
                               Text="{Binding ElementName=MacrosListBox, Path=Items.Count, StringFormat=MACROS — {0}}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="8" FontWeight="Bold"
                               Foreground="#4A5A4A"
                               Margin="14,8,14,4"/>

                    <!-- Liste des macros (scroll) -->
                    <Border Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ClipToBounds="False" Background="Transparent" Margin="0,0,0,8">
                            <ScrollViewer Style="{StaticResource ScrollViewerNoClipStyle}"
                                      VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                      Padding="0,0,0,12"
                                          Background="Transparent">
                                    <ListBox x:Name="MacrosListBox"
                                             Style="{StaticResource MacrosListBoxStyle}"
                                             SelectionChanged="MacrosListBox_SelectionChanged"
                                             ItemContainerStyle="{StaticResource MacroListMainWindowItemStyle}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel ClipToBounds="False"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MaxHeight="52"
                                          MinHeight="26"
                                          VerticalAlignment="Stretch"
                                          ClipToBounds="True">
                                        <Grid.ColumnDefinitions>
                                            <!-- Auto : pas de colonne vide quand l'icône est masquée -->
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icône m-icon 26×26 (sélection = bordure ambre) -->
                                        <Border Grid.Column="0"
                                                Width="26" Height="26"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,8,0"
                                                Background="{StaticResource BackgroundLevel4Brush}"
                                                BorderThickness="1"
                                                BorderBrush="{StaticResource BorderMediumBrush}"
                                                Visibility="{Binding IconType, Converter={StaticResource IconVisibilityConverter}}"
                                                ToolTip="{Binding IsEnabled, Converter={StaticResource MacroDisabledTooltipConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter Property="Opacity" Value="0.4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <TextBlock FontFamily="{StaticResource FontLucide}" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Text="{Binding LucideIconCode, Converter={StaticResource LucideIconCharConverter}}"
                                                           Foreground="{Binding IconColor, Converter={StaticResource HexToBrushConverter}}"
                                                           Visibility="{Binding IconType, Converter={StaticResource IconTypeMatchConverter}, ConverterParameter=Lucide}"/>
                                                <Image Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Source="{Binding ProcessIconPath, Converter={StaticResource ProcessIconConverter}}"
                                                       Visibility="{Binding IconType, Converter={StaticResource IconTypeMatchConverter}, ConverterParameter=Process}"/>
                                            </Grid>
                                        </Border>

                                        <!-- Nom + raccourci : bloc centré verticalement (avec ou sans raccourci) -->
                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Stretch"
                                                    Orientation="Vertical">
                                            <TextBlock Text="{Binding Name}"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       HorizontalAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                                            <TextBlock Text="{Binding ShortcutKeyCode, Converter={StaticResource KeyCodeToNameConverter}}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Left"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,1,0,0"
                                                       Visibility="{Binding ShortcutKeyCode, Converter={StaticResource ShortcutVisibilityConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentPrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                        </Border>

                    <!-- Footer rail : ligne + bloc profil + Supprimer -->
                    <Border Grid.Row="5" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0" Padding="6,8">
                        <StackPanel>
                            <Rectangle Height="1" Fill="{StaticResource BorderLightBrush}" Margin="0,0,0,8"/>
                            <Border Background="#111311" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1"
                                    Padding="10,8" Margin="0,0,0,5">
                                <Grid>
                                        <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3"/>
                                        <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                    <Rectangle Grid.Column="0" Fill="#39D97A" VerticalAlignment="Stretch">
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#39D97A" BlurRadius="6" ShadowDepth="0"/>
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="PROFIL ACTIF" FontFamily="{StaticResource FontMono}" FontSize="8"
                                                   Foreground="#4A5A4A" Margin="0,0,0,2"/>
                                        <TextBlock x:Name="ActiveProfileText" Text="Par défaut"
                                                   FontFamily="{StaticResource FontPrimary}" FontSize="14" FontWeight="Bold"
                                                   Foreground="#C8D4C8"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Style="{StaticResource ButtonGhost}"
                                            Click="ManageProfiles_Click" Padding="4" ToolTip="Gérer les profils">
                                        <TextBlock Text="&#xE30B;" FontFamily="{StaticResource FontLucide}" FontSize="14" Foreground="#4A5A4A"/>
                                        </Button>
                                        </Grid>
                                    </Border>
                            <Button Style="{StaticResource ButtonGhostDanger}"
                                    Click="DeleteMacro_Click"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,7">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="✕  SUPPRIMER" VerticalAlignment="Center"
                                               FontFamily="{StaticResource FontMono}" FontSize="9" FontWeight="Bold"
                                               Foreground="#4A5A4A"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════ WORKSPACE (centre) ═══════════════════════════ -->
            <Border Grid.Column="2" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderLightBrush}" Padding="0">
                <Grid>
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,32,32" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#080A08">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,32,32"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing>
                                        <GeometryDrawing.Pen>
                                            <Pen Brush="#0D1A0D" Thickness="0.5"/>
                                        </GeometryDrawing.Pen>
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <LineGeometry StartPoint="32,0" EndPoint="32,32"/>
                                                <LineGeometry StartPoint="0,32" EndPoint="32,32"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition x:Name="BottomPanelRow" Height="120"/>
                    </Grid.RowDefinitions>

                    <!-- ── BARRE D'ACTION (command bar) ── -->
                    <Border Grid.Row="0"
                            Background="#0D0F0D"
                            BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,0,1"
                            UseLayoutRounding="True" SnapsToDevicePixels="True"
                            RenderOptions.ClearTypeHint="Enabled">
                        <DockPanel LastChildFill="False" UseLayoutRounding="True">
                            <!-- Droite : ENREG. / STOP. (même bouton), PROPS -->
                            <Border DockPanel.Dock="Right"
                                    BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="MacroEnableToggle"
                                                  Style="{StaticResource MacroPowerToggleStyle}"
                                                  Checked="MacroEnableToggle_Checked"
                                                  Unchecked="MacroEnableToggle_Unchecked"
                                                  IsEnabled="False"
                                                  ToolTip="Activer / désactiver la macro"/>
                                    <Border BorderBrush="White" BorderThickness="1,0,0,0" VerticalAlignment="Stretch">
                                        <Button x:Name="MainRecordToolbarButton" Padding="11,6,11,8" Cursor="Hand"
                                                Background="#E8A020" BorderBrush="Transparent" BorderThickness="0"
                                                FocusVisualStyle="{x:Null}"
                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                Click="StartMacro_Click"
                                                ToolTip="Enregistrer une macro">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse x:Name="MainRecordToolbarDot" Width="8" Height="8" Fill="#0A0800"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="MainRecordToolbarLabel" Text="ENREG." FontFamily="{StaticResource FontPrimary}"
                                                           FontSize="10" FontWeight="Black"
                                                           Foreground="#0A0800" HorizontalAlignment="Center" TextAlignment="Center"
                                                           MinWidth="46" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Border>
                                    <Button x:Name="PropsToggleButton" Style="{StaticResource ActionCard}" Padding="14,6,14,8"
                                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                            Click="PropsToggleButton_Click">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⚙" FontSize="14" Foreground="#E8A020" HorizontalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Text="PROPS" FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="10" FontWeight="Bold"
                                                       Foreground="#4A5A4A" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <!-- Gauche : AJOUTER UNE ACTION + OUTILS -->
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Style="{StaticResource ToolbarSectionLabelStyle}"
                                                   Text="AJOUTER UNE ACTION"
                                                   Margin="10,4,10,0"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="keyboard">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#1234C8B8" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE284;" FontFamily="{StaticResource FontLucide}" FontSize="12" Foreground="#34C8B8"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="TOUCHE" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#7A927A" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="mouse">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#1234C8B8" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE28E;" FontFamily="{StaticResource FontLucide}" FontSize="12" Foreground="#34C8B8"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="CLIC" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#7A927A" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Rectangle Width="1" Height="24" Fill="{StaticResource BorderLightBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="text">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#1C201C" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE0CC;" FontFamily="{StaticResource FontLucide}" FontSize="12"
                                                                   Foreground="#4A5A4A"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="TEXTE" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#7A927A" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="delay">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#1AE8A020" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE1E0;" FontFamily="{StaticResource FontLucide}" FontSize="12" Foreground="#E8A020"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="DÉLAI" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#7A927A" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Rectangle Width="1" Height="24" Fill="{StaticResource BorderLightBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="variable">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#15A78BFA" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE36A;" FontFamily="{StaticResource FontLucide}" FontSize="12"
                                                                   Foreground="#A78BFA"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="VARIABLE" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#7A927A" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="condition">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#15E84040" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE440;" FontFamily="{StaticResource FontLucide}" FontSize="12"
                                                                   Foreground="#E84040"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="CONDITION" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#7A927A" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="repeat">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#1239D97A" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE411;" FontFamily="{StaticResource FontLucide}" FontSize="12"
                                                                   Foreground="#39D97A"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="RÉPÉTER" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold"
                                                               Foreground="#7A927A" HorizontalAlignment="Center"
                                                               Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Style="{StaticResource ToolbarSectionLabelStyle}"
                                                   Text="OUTILS"
                                                   Margin="10,4,10,0"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="presets">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#1C201C" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE470;" FontFamily="{StaticResource FontLucide}" FontSize="12" Foreground="#4A5A4A"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="PRESETS" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold" Foreground="#7A927A"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Rectangle Width="1" Height="24" Fill="{StaticResource BorderLightBrush}" VerticalAlignment="Center" Margin="2,0"/>
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="undo">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#1C201C" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE148;" FontFamily="{StaticResource FontLucide}" FontSize="12" Foreground="#4A5A4A"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="ANNULER" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold" Foreground="#7A927A"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ActionCard}" Click="QuickAddAction_Click" Tag="redo">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="4"
                                                            Background="#1C201C" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE149;" FontFamily="{StaticResource FontLucide}" FontSize="12" Foreground="#4A5A4A"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="REFAIRE" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold" Foreground="#7A927A"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,0,1,0">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top"
                                                   Style="{StaticResource ToolbarSectionLabelStyle}"
                                                   Text="EXECUTION"
                                                   Margin="8,4,8,0"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ActionCard}" Padding="6,5,6,6" MinWidth="48"
                                                    Click="ExecuteMacro_Click"
                                                    ToolTip="Exécuter la macro sélectionnée (bouton ou raccourci de la macro)">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <!-- * | icône | gap | raccourci | * -->
                                                    <Grid Width="70" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="3"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="4"
                                                                Background="#1239D97A" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE13C;" FontFamily="{StaticResource FontLucide}" FontSize="12" Foreground="#39D97A"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock x:Name="ExecuteMacroShortcutHintText"
                                                                   Grid.Column="3"
                                                                   Style="{StaticResource ToolbarShortcutHintStyle}"
                                                                   Visibility="Collapsed"/>
                                                    </Grid>
                                                    <TextBlock Text="LANCER" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold" Foreground="#7A927A"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ActionCard}" Padding="6,5,6,6" MinWidth="48"
                                                    Click="StepMacro_Click"
                                                    ToolTip="Exécuter une seule action à chaque clic">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Grid Width="70" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="3"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="4"
                                                                Background="#1AE8A020" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE3EA;" FontFamily="{StaticResource FontLucide}" FontSize="12" Foreground="#E8A020"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="3"
                                                                   Style="{StaticResource ToolbarShortcutHintStyle}"
                                                                   Text="Clic"/>
                                                    </Grid>
                                                    <TextBlock Text="PAS À PAS" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold" Foreground="#7A927A"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource ActionCard}" Padding="6,5,6,6" MinWidth="48"
                                                    Click="StopMacro_Click"
                                                    ToolTip="Arrêter l'exécution ou l'enregistrement">
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Grid Width="70" HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="22"/>
                                                            <ColumnDefinition Width="3"/>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="1" Width="22" Height="22" CornerRadius="4"
                                                                Background="#15E84040" VerticalAlignment="Center">
                                                            <TextBlock Text="&#xE167;" FontFamily="{StaticResource FontLucide}" FontSize="12" Foreground="#E84040"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock x:Name="StopGlobalShortcutHintText"
                                                                   Grid.Column="3"
                                                                   Style="{StaticResource ToolbarShortcutHintStyle}"/>
                                                    </Grid>
                                                    <TextBlock Text="ARRÊTER" FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="10" FontWeight="Bold" Foreground="#7A927A"
                                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Zone éditeur (TimelineEditor) -->
                    <ContentControl x:Name="MacroEditorContainer" Grid.Row="1" Margin="8,8,2,8"/>
                    <!-- Barre du bas (bottombar) -->
                    <Border Grid.Row="2" Background="#0D0F0D" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="320"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Historique (log-panel) -->
                        <Border x:Name="ActionsPanelBorder" Grid.Column="0" 
                                Background="#0D0F0D"
                                BorderThickness="0,1,1,0"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                Padding="16,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="HISTORIQUE" 
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="8" FontWeight="Bold"
                                               Foreground="#4A5A4A"
                                               VerticalAlignment="Center"/>
                                    <Border Margin="8,0,0,0" Padding="6,1" 
                                            Background="#111311"
                                            BorderBrush="{StaticResource BorderLightBrush}"
                                            BorderThickness="1">
                                    <TextBlock x:Name="ActionsCountText" 
                                                   Text="0" 
                                                   FontFamily="{StaticResource FontMono}"
                                                   FontSize="9"
                                                   Foreground="#E8A020"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Content="Effacer" 
                                            x:Name="ClearActionsButton" 
                                            Style="{StaticResource ButtonGhost}"
                                            Click="ClearActionsButton_Click" 
                                            Padding="4,0"
                                            Margin="8,0,0,0"
                                            FontSize="9"
                                            FontFamily="{StaticResource FontMono}"/>
                                </StackPanel>
                                <ListBox x:Name="ActionsListBox" 
                                         Grid.Row="1"
                                         SelectionMode="Single"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Timestamp}" 
                                                           Style="{StaticResource TextMuted}"
                                                           Width="70"/>
                                                <TextBlock Text="{Binding Description}" 
                                                           Style="{StaticResource TextSecondary}"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                        
                        <!-- Zone de test (test-panel) -->
                        <Border x:Name="TestPanelBorder" Grid.Column="1"
                                Background="#0D0F0D"
                                BorderThickness="0"
                                Padding="0,10,14,10">
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Rectangle Grid.Column="0" Fill="{StaticResource BorderLightBrush}" Margin="0,0,14,0"/>
                                <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" 
                                               Text="ZONE DE TEST" 
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="8" FontWeight="Bold"
                                               Foreground="#4A5A4A"
                                               Margin="0,0,0,6"/>
                                <TextBox x:Name="TestTextBox" 
                                         Grid.Row="1"
                                             Background="#111311"
                                             Foreground="#7A927A"
                                             BorderBrush="{StaticResource BorderLightBrush}"
                                             BorderThickness="1"
                                             FontFamily="{StaticResource FontMono}"
                                             FontSize="11"
                                             Padding="10,8"
                                         AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             CaretBrush="#E8A020"
                                         VerticalScrollBarVisibility="Auto"
                                             Text="Tapez ici pour tester vos macros…"
                                         GotFocus="TestTextBox_GotFocus"/>
                                </Grid>
                            </Grid>
                            </Border>
                    </Grid>
                        </Border>
                </Grid>
            </Border>

            <!-- ═══════════════════════════ PANNEAU PROPRIÉTÉS ═══════════════════════════ -->
            <Border x:Name="PropsPanelBorder"
                    Grid.Column="2"
                    Panel.ZIndex="20"
                    HorizontalAlignment="Right"
                    Width="240" MinWidth="240" MaxWidth="240"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="PropsPanelTranslate" X="256"/>
                </Border.RenderTransform>
                <Grid DataContext="{Binding SelectedItem, ElementName=MacrosListBox}">
                    <Border Background="{StaticResource BackgroundPrimaryBrush}"
                            BorderBrush="{StaticResource AccentPrimaryBrush}"
                            BorderThickness="1,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Header -->
                            <Border Grid.Row="0" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <DockPanel LastChildFill="True" Margin="8,8,8,6">
                                        <Button DockPanel.Dock="Right" x:Name="PropsCloseHeaderButton"
                                                Style="{StaticResource PropsCloseHeaderButtonStyle}" Padding="2,0" Cursor="Hand"
                                                ToolTip="Fermer" Click="PropsToggleButton_Click" Margin="4,0,0,0">
                                            <TextBlock Text="✕" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                        </Button>
                                        <Border DockPanel.Dock="Right" Margin="0,0,6,0" Padding="4,2,6,2"
                                                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="4" Height="4" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="EngineStateText" Text="PRÊT" FontFamily="{StaticResource FontMono}"
                                                           FontSize="8" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border DockPanel.Dock="Left" Width="24" Height="24"
                                                Background="{StaticResource BackgroundLevel4Brush}"
                                                BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1"
                                                Margin="0,0,7,0" VerticalAlignment="Center">
                                            <Grid>
                                                <TextBlock FontFamily="{StaticResource FontLucide}" FontSize="13"
                                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                                           Text="{Binding SelectedItem.LucideIconCode, ElementName=MacrosListBox, Converter={StaticResource LucideIconCharConverter}, FallbackValue='', TargetNullValue=''}"
                                                           Foreground="{Binding SelectedItem.IconColor, ElementName=MacrosListBox, Converter={StaticResource HexToBrushConverter}}"
                                                           Visibility="{Binding SelectedItem.IconType, ElementName=MacrosListBox, Converter={StaticResource IconTypeMatchConverter}, ConverterParameter=Lucide}"/>
                                                <Image Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Source="{Binding SelectedItem.ProcessIconPath, ElementName=MacrosListBox, Converter={StaticResource ProcessIconConverter}}"
                                                       Visibility="{Binding SelectedItem.IconType, ElementName=MacrosListBox, Converter={StaticResource IconTypeMatchConverter}, ConverterParameter=Process}"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="PropsHeaderMacroTitle" Text="{Binding SelectedItem.Name, ElementName=MacrosListBox, FallbackValue='', TargetNullValue=''}"
                                                   FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    </DockPanel>
                                    <!-- Onglets -->
                                    <UniformGrid Rows="1" Columns="3">
                                        <Button x:Name="PropsTabIdentiteButton" Tag="Identite" Click="PropsTabButton_Click"
                                                Background="Transparent" BorderThickness="0,0,0,1"
                                                BorderBrush="{StaticResource BorderMediumBrush}" Padding="4,6"
                                                FontFamily="{StaticResource FontPrimary}" FontSize="10" FontWeight="Bold"
                                                Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" Content="IDENTITÉ"/>
                                        <Button x:Name="PropsTabExecutionButton" Tag="Execution" Click="PropsTabButton_Click"
                                                Background="Transparent" BorderThickness="0,0,0,1"
                                                BorderBrush="{StaticResource BorderMediumBrush}" Padding="4,6"
                                                FontFamily="{StaticResource FontPrimary}" FontSize="10" FontWeight="Bold"
                                                Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" Content="EXÉCUTION"/>
                                        <Button x:Name="PropsTabSystemeButton" Tag="Systeme" Click="PropsTabButton_Click"
                                                Background="Transparent" BorderThickness="0,0,0,1"
                                                BorderBrush="{StaticResource BorderMediumBrush}" Padding="4,6"
                                                FontFamily="{StaticResource FontPrimary}" FontSize="10" FontWeight="Bold"
                                                Foreground="{StaticResource TextSecondaryBrush}" Cursor="Hand" Content="SYSTÈME"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <!-- Contenu scrollable -->
                            <ScrollViewer x:Name="PropsScrollViewer" Grid.Row="1" Style="{StaticResource ScrollViewerPropsPanelStyle}"
                                          Background="Transparent">
                                <StackPanel>
                                    <!-- IDENTITÉ -->
                                    <StackPanel x:Name="PropsPaneIdentite" Visibility="Visible">
                                        <Border BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,0,1" Padding="8,14,8,12">
                                            <StackPanel>
                                                <TextBlock Text="IDENTIFICATION" Style="{StaticResource PropsPanelFieldLabelStyle}"
                                                           Margin="0,0,0,10"/>
                                                <TextBlock Text="NOM DE LA MACRO" Style="{StaticResource PropsPanelFieldLabelStyle}" Margin="0,0,0,3"/>
                                                <Border Background="{StaticResource BackgroundPrimaryBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1,1,1,1"
                                                        Margin="0,0,0,10">
                                                    <Border BorderBrush="{StaticResource AccentPrimaryBrush}" BorderThickness="0,0,0,1">
                                                        <TextBox x:Name="MacroNameTextBox" Style="{StaticResource TextBoxNoCornerRadius}" BorderThickness="0" Background="Transparent"
                                                                 Padding="4,4,4,4" FontFamily="{StaticResource FontMono}" FontSize="12" FontWeight="SemiBold"
                                                                 Foreground="{StaticResource TextPrimaryBrush}" CaretBrush="{StaticResource AccentPrimaryBrush}"
                                                                 VerticalContentAlignment="Center" TextWrapping="NoWrap" AcceptsReturn="False"
                                                                 TextChanged="MacroNameTextBox_TextChanged" SizeChanged="MacroIdentityTextBox_SizeChanged"/>
                                                    </Border>
                                                </Border>
                                                <TextBlock Text="DESCRIPTION" Style="{StaticResource PropsPanelFieldLabelStyle}" Margin="0,0,0,3"/>
                                                <Border Background="{StaticResource BackgroundPrimaryBrush}" BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Margin="0,0,0,0" ClipToBounds="True">
                                                    <TextBox x:Name="MacroDescriptionTextBox" Style="{StaticResource TextBoxPropsDescriptionStyle}" BorderThickness="0" Background="Transparent"
                                                             HorizontalScrollBarVisibility="Disabled"
                                                             Padding="4,4,4,4" FontFamily="{StaticResource FontMono}" FontSize="10" FontWeight="Normal"
                                                             MinLines="5" MaxLines="5" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                                             TextChanged="MacroDescriptionTextBox_TextChanged" SizeChanged="MacroIdentityTextBox_SizeChanged"
                                                             CaretBrush="{StaticResource AccentPrimaryBrush}"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <Border BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,0,1" Padding="8,14,8,12">
                                            <StackPanel>
                                                <!-- Titre ICÔNE + trait + ajout processus (alignés sur une ligne) -->
                                                <Grid Margin="0,0,0,4" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
