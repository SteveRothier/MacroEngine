                                                    <TextBlock Text="Activer au démarrage" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                </DockPanel>
                                                <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                                    <ToggleButton x:Name="PropsStealthToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStylePropsCompact}" Width="32" Height="17" IsEnabled="False" Opacity="0.45"/>
                                                    <TextBlock Text="Mode furtif" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                </DockPanel>
                                                <DockPanel LastChildFill="False">
                                                    <ToggleButton x:Name="PropsActionLogToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitchStylePropsCompact}" Width="32" Height="17" IsEnabled="False" Opacity="0.45" IsChecked="True"/>
                                                    <TextBlock Text="Journal des actions" FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="Normal" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="0,0,0,0" Padding="8,14,8,12">
                                            <StackPanel>
                                                <TextBlock Text="ZONE DE DANGER" Style="{StaticResource PropsPanelFieldLabelStyle}" Margin="0,0,0,10"/>
                                                <Button Content="✕ SUPPRIMER CETTE MACRO" Style="{StaticResource ButtonGhostDanger}" Margin="0,0,0,4" Padding="8,6" FontFamily="{StaticResource FontMono}" FontSize="8" FontWeight="Bold" Click="DeleteMacro_Click"/>
                                                <Button Content="⎘ DUPLIQUER LA MACRO" Style="{StaticResource ButtonGhostPropsPanelSquare}" Margin="0,0,0,4" Padding="8,6" FontFamily="{StaticResource FontMono}" FontSize="8" FontWeight="Bold"
                                                        BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Click="DuplicateMacroProps_Click"/>
                                                <Button Content="↓ EXPORTER EN .JSON" Style="{StaticResource ButtonGhostPropsPanelSquare}" Padding="8,6" FontFamily="{StaticResource FontMono}" FontSize="8" FontWeight="Bold"
                                                        BorderBrush="{StaticResource BorderMediumBrush}" BorderThickness="1" Click="ExportMacro_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <!-- Panneau apps (chips) masqué visuellement mais conservé pour le code-behind -->
                                        <Border Visibility="Collapsed" Height="0">
                                            <StackPanel>
                                                <Button x:Name="SelectAppsButton" Click="SelectApps_Click"/>
                                                <WrapPanel x:Name="TargetAppsPanel"/>
                                                <TextBlock x:Name="NoAppsText" Text="Toutes les applications"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════════════
                 STATUSBAR - Barre de statut
                 ══════════════════════════════════════════════════════════════════ -->
            <!-- Barre de statut retirée ; StatusText/TimeText gardés masqués pour le code-behind -->
            <Grid Grid.Row="2" Visibility="Collapsed" Height="0">
                <TextBlock x:Name="StatusText" Text="Prêt"/>
                <TextBlock x:Name="TimeText" Text="00:00:00"/>
                </Grid>
        </Grid>
    </Border>
</Window>